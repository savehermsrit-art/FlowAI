# Generated locally by scripts/setup.ps1. Never use these examples as credentials.
POSTGRES_PASSWORD=GENERATE_LOCALLY
MINIO_ROOT_USER=formflow
MINIO_ROOT_PASSWORD=GENERATE_LOCALLY
FORMFLOW_KEY=GENERATE_FERNET_KEY
FORMFLOW_MODE=DEMO
RETENTION_DAYS=30
# Production requires a configured local malware scanner. Demo accepts synthetic data only.
DEVELOPMENT=true
# The Compose backend reaches Ollama on the host through host.docker.internal.
# Install Ollama, pull qwen3:4b, and allow the Docker VM to reach port 11434.
FORMFLOW_LLM_PROVIDER=ollama
FORMFLOW_LLM_MODEL=qwen3:4b
# FORMFLOW_LLM_URL=http://host.docker.internal:11434
# FORMFLOW_LLM_TIMEOUT=90
# Optional OpenAI-compatible endpoint: set PROVIDER=openai_compatible,
# LLM_URL to the endpoint's /v1 base, LLM_MODEL and LLM_API_KEY.
