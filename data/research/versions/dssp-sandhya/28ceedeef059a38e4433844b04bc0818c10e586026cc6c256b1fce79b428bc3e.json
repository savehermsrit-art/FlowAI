    {
      "id": "dssp-sandhya:28ceedeef059:1",
      "source_id": "dssp-sandhya",
      "scheme_id": "ka-sandhya",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "28ceedeef059",
      "section": "ಸಂಧ್ಯಾ ಸುರಕ್ಷಾ ಯೋಜನೆ",
      "page": null,
      "text": "65 ವರ್ಷದ ಅಥವಾ ಮೇಲ್ಪಟ್ಟ ವಯಸ್ಸಿನ ಹಿರಿಯ ಜೀವಗಳನ್ನು ಆರ್ಥಿಕ ಸಂಕಷ್ಟದಿಂದ ಪಾರು ಮಾಡುವ ದಿಶೆಯಲ್ಲಿ ಸಂಧ್ಯಾ ಸುರಕ್ಷಾ ಯೋಜನೆಯನ್ನು ದಿನಾಂಕ:2-7-2007 ರಿಂದ ಮಾಸಾಶನವನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗಿದೆ. ಕೆಳಕಂಡ ವ್ಯಕ್ತಿಗಳು ಈ ಮಾಸಾಶನವನ್ನು ಅರ್ಹರಾಗಿರುತ್ತಾರೆ.",
      "url": "https://dssp.karnataka.gov.in/dssp/Sandhya_Suraksha.aspx"
    },
