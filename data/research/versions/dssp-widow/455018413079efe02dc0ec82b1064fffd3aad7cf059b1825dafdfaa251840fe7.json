    },
    {
      "id": "dssp-widow:455018413079:1",
      "source_id": "dssp-widow",
      "scheme_id": "ka-widow",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "455018413079",
      "section": "ವಿಧವಾ ವೇತನ ಯೋಜನೆ",
      "page": null,
      "text": "ಬಡತನ ರೇಖೆಗಿಂತ ಕೆಳಗಿರುವ 18 ರಿಂದ 64 ವರ್ಷದೊಳಗಿನ ನಿರ್ಗತಿಕ ವಿಧವೆಯರಿಗೆ ವಿಧವಾ ವೇತನವನ್ನು ಸರ್ಕಾರದ ಆದೇಶದ ಮೇರೆಗೆ 1ನೇಏಪ್ರಿಲ್ 1984 ರಿಂದ ಕಾರ್ಯಗತ ಮಾಡಲಾಗಿದೆ.",
      "url": "https://dssp.karnataka.gov.in/dssp/Widow_Scheme.aspx"
    },
    {
      "id": "dssp-widow:455018413079:2",
      "source_id": "dssp-widow",
      "scheme_id": "ka-widow",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "455018413079",
      "section": "ಅರ್ಹತಾ ಮಾನದಂಡ:",
      "page": null,
      "text": "ಅರ್ಹತಾ ಮಾನದಂಡ:",
      "url": "https://dssp.karnataka.gov.in/dssp/Widow_Scheme.aspx"
    },
    {
      "id": "dssp-widow:455018413079:4",
      "source_id": "dssp-widow",
      "scheme_id": "ka-widow",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "455018413079",
      "section": "ಅರ್ಹತಾ ಮಾನದಂಡ:",
      "page": null,
      "text": "ವಿಧವೆ ಅಂದರೆ, ಪತಿಯ ಜೀವಿಸಿಲ್ಲದ ಅಥವಾ ಕಾನೂನು ರೀತ್ಯಾ ಮೃತಪಟ್ಟಿರುವನೆಂದು ಭಾವಿಸುವವನ ಪತ್ನಿ ಮತ್ತು ಅವಳ ಸಂಬಂಧಿಕ ಒಬ್ಬ ಸ್ತ್ರೀ.",
      "url": "https://dssp.karnataka.gov.in/dssp/Widow_Scheme.aspx"
    },
    {
      "id": "dssp-widow:455018413079:6",
      "source_id": "dssp-widow",
      "scheme_id": "ka-widow",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "455018413079",
      "section": "ಅರ್ಹತಾ ಮಾನದಂಡ:",
      "page": null,
      "text": "ವಾರ್ಷಿಕ ಆದಾಯ ಗ್ರಾಮೀಣ ಹಾಗೂ ನಗರ ಪ್ರದೇಶಗಳಲ್ಲಿ ರೂ. 32,000/- ಕ್ಕಿಂತ ಕಡಿಮೆ ಇರಬೇಕು.",
      "url": "https://dssp.karnataka.gov.in/dssp/Widow_Scheme.aspx"
    },
    {
      "id": "dssp-widow:455018413079:8",
      "source_id": "dssp-widow",
      "scheme_id": "ka-widow",
      "department": "Directorate of Social Security and Pensions",
      "language": "kn",
      "version": "455018413079",
      "section": "ಅರ್ಹತಾ ಮಾನದಂಡ:",
      "page": null,
      "text": "ಮೃತರಾಗುವವರೆಗೆ ಅಥವಾ ಪುನರ್ವಿವಾಹವಾಗುವವರೆಗೆ ಅಥವಾ ಉದ್ಯೋಗ ಪಡೆದು ನಿಗಧಿತ ವಾರ್ಷಿಕ ಆದಾಯಕ್ಕಿಂತ ಹೆಚ್ಚಿನ ಆದಾಯ ಪಡೆಯುವವರೆಗೆ ವಿಧವೆಯ ವಿಧವಾ ವೇತನವನ್ನು ಪಡೆಯಬಹುದು.",
      "url": "https://dssp.karnataka.gov.in/dssp/Widow_Scheme.aspx"
    },
    {
